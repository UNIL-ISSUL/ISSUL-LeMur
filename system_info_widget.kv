#:import NoTransition kivy.uix.screenmanager.NoTransition

<SystemInfoWidget>:
    orientation: 'vertical'
    padding: ['10dp', '10dp', '10dp', '10dp']
    spacing: '8dp'

    # --- TOP STATUS & ACTION BAR (RESPONSIVE 2-ROW) ---
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: '74dp'
        spacing: '6dp'

        # Row 1: Hardware Status & View Switcher
        BoxLayout:
            size_hint_y: None
            height: '34dp'
            spacing: '6dp'

            Button:
                text: root.connection_text
                font_size: '13sp'
                bold: True
                size_hint_x: None
                width: '145dp'
                background_color: root.connection_bg
                background_normal: ''
                disabled: True

            Label:
                text: 'Cycle: ' + root.cycletime_text
                font_size: '13sp'
                size_hint_x: None
                width: '90dp'
                color: [0.85, 0.85, 0.85, 1]

            Button:
                text: 'I/O Err: ' + root.ioerrors_text
                font_size: '13sp'
                bold: True
                size_hint_x: None
                width: '85dp'
                background_color: root.ioerrors_bg
                background_normal: ''
                disabled: True

            Button:
                text: 'Modbus: ' + root.modbus_master_text
                font_size: '13sp'
                bold: True
                size_hint_x: None
                width: '115dp'
                background_color: root.modbus_master_bg
                background_normal: ''
                disabled: True

            Widget:
                # Flexible horizontal spacer

            ToggleButton:
                text: 'Synthèse'
                group: 'sys_view'
                state: 'down' if root.view_mode == 'summary' else 'normal'
                font_size: '13sp'
                size_hint_x: None
                width: '95dp'
                allow_no_selection: False
                on_press: root.switch_view('summary')

            ToggleButton:
                text: 'Explorateur'
                group: 'sys_view'
                state: 'down' if root.view_mode == 'explorer' else 'normal'
                font_size: '13sp'
                size_hint_x: None
                width: '95dp'
                allow_no_selection: False
                on_press: root.switch_view('explorer')

        # Row 2: Diagnostic Actions & Auto-Recovery Controls
        BoxLayout:
            size_hint_y: None
            height: '34dp'
            spacing: '6dp'

            Button:
                text: 'Reset Modbus'
                font_size: '13sp'
                bold: True
                size_hint_x: None
                width: '120dp'
                background_color: [0.2, 0.55, 0.8, 1]
                background_normal: ''
                on_press: root.reset_modbus_clicked()

            Button:
                text: 'Impulsion START'
                font_size: '13sp'
                bold: True
                size_hint_x: None
                width: '130dp'
                background_color: [0.2, 0.65, 0.35, 1]
                background_normal: ''
                on_press: root.pulse_start_clicked()

            Button:
                text: 'Auto-Recovery: ON' if root.modbus_auto_recovery_active else 'Auto-Recovery: OFF'
                font_size: '12sp'
                bold: True
                size_hint_x: None
                width: '145dp'
                background_color: root.modbus_auto_recovery_bg
                background_normal: ''
                on_press: root.toggle_auto_recovery_clicked()

            Label:
                text: 'Resets auto: ' + root.modbus_auto_reset_count_text
                font_size: '12sp'
                size_hint_x: None
                width: '95dp'
                color: [0.75, 0.85, 0.95, 1]

            Label:
                text: 'Surveillance et déverrouillage automatique des erreurs 110/17'
                font_size: '11sp'
                color: [0.55, 0.65, 0.75, 1]
                halign: 'left'
                valign: 'middle'
                text_size: self.size

    # --- BANNER ALERTE DECROCHAGE (SI ACTIF) ---
    BoxLayout:
        size_hint_y: None
        height: '32dp' if root.stall_warning else '0dp'
        opacity: 1 if root.stall_warning else 0
        disabled: not root.stall_warning
        canvas.before:
            Color:
                rgba: 0.85, 0.15, 0.15, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'ALERTE : Tapis commandé en vitesse mais bande immobile (PV=0) ! Variateur désenclenché ou calé.'
            font_size: '13sp'
            bold: True
            color: [1, 1, 1, 1]

    # --- CONTENEUR DES VUES (SCREEN MANAGER AVEC NOTRANSITION) ---
    ScreenManager:
        id: sys_sm
        transition: NoTransition()

        # =========================================================
        # VUE 1 : SYNTHÈSE TEMPS RÉEL (E/S + REGISTRES + JOURNAL)
        # =========================================================
        Screen:
            name: 'summary'
            BoxLayout:
                orientation: 'horizontal'
                spacing: '10dp'

                # --- COLONNE GAUCHE (SCROLLABLE : CARTES DO, MODBUS, DI) ---
                ScrollView:
                    size_hint_x: 0.54
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: '8dp'
                    scroll_type: ['bars', 'content']

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '10dp'
                        padding: ['0dp', '0dp', '8dp', '0dp']

                        # CARTE 1: SORTIES NUMERIQUES (DO)
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            padding: ['10dp', '8dp', '10dp', '8dp']
                            spacing: '4dp'
                            canvas.before:
                                Color:
                                    rgba: 0.14, 0.16, 0.19, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            Label:
                                text: 'SORTIES NUMÉRIQUES (DO) - COMMANDE VARIATEUR'
                                font_size: '13sp'
                                bold: True
                                color: [0.4, 0.85, 1, 1]
                                size_hint_y: None
                                height: '24dp'
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size

                            # belt_start row
                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'belt_start (Impulsion START variateur)'
                                    font_size: '13sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Button:
                                    text: '1 - ACTIF' if root.belt_start_val else '0 - REPOS'
                                    font_size: '12sp'
                                    bold: True
                                    size_hint_x: None
                                    width: '100dp'
                                    background_color: [0.15, 0.7, 0.25, 1] if root.belt_start_val else [0.25, 0.27, 0.3, 1]
                                    background_normal: ''
                                    disabled: True

                            # belt_stop row
                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'belt_stop (Autorisation marche RUN / STOP)'
                                    font_size: '13sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Button:
                                    text: '1 - RUN PERMIS' if root.belt_stop_val else '0 - ARRÊT'
                                    font_size: '12sp'
                                    bold: True
                                    size_hint_x: None
                                    width: '100dp'
                                    background_color: [0.15, 0.7, 0.25, 1] if root.belt_stop_val else [0.85, 0.2, 0.2, 1]
                                    background_normal: ''
                                    disabled: True

                            # belt_dir row
                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'belt_dir (Sens de rotation)'
                                    font_size: '13sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Button:
                                    text: 'AVANT (1)' if root.belt_dir_val else 'ARRIÈRE (0)'
                                    font_size: '12sp'
                                    size_hint_x: None
                                    width: '100dp'
                                    background_color: [0.2, 0.45, 0.65, 1]
                                    background_normal: ''
                                    disabled: True

                            # use_steps row
                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'use_steps (Mode marches-barres)'
                                    font_size: '13sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Button:
                                    text: 'MARCHES (1)' if root.use_steps_val else 'BANDE (0)'
                                    font_size: '12sp'
                                    size_hint_x: None
                                    width: '100dp'
                                    background_color: [0.25, 0.27, 0.3, 1]
                                    background_normal: ''
                                    disabled: True

                                                # CARTE 2: REGISTRES MODBUS & COMMANDES VARIATEUR
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            padding: ['10dp', '8dp', '10dp', '8dp']
                            spacing: '3dp'
                            canvas.before:
                                Color:
                                    rgba: 0.14, 0.16, 0.19, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            Label:
                                text: 'REGISTRES MODBUS & COMMANDES VARIATEUR'
                                font_size: '13sp'
                                bold: True
                                color: [0.4, 0.85, 1, 1]
                                size_hint_y: None
                                height: '24dp'
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Vitesse cible SP (IHM) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.belt_speed_sp_text
                                    size_hint_x: 0.38
                                    font_size: '13sp'
                                    bold: True
                                    color: [1, 1, 1, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Consigne CMD (avec trim) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.belt_speed_cmd_text
                                    size_hint_x: 0.38
                                    font_size: '13sp'
                                    bold: True
                                    color: [0.3, 0.9, 1, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Fréquence envoyée variateur :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.freq_sent_text
                                    size_hint_x: 0.38
                                    font_size: '13sp'
                                    bold: True
                                    color: [1, 0.9, 0.2, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Fréquence mesurée (retour) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.freq_pv_text
                                    size_hint_x: 0.38
                                    font_size: '13sp'
                                    bold: True
                                    color: [0.95, 0.75, 0.2, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Registres SP (SP0 / SP1) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    color: [0.75, 0.85, 0.9, 1]
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: 'SP0=' + root.sp_0_text + ' | SP1=' + root.sp_1_text
                                    size_hint_x: 0.38
                                    font_size: '12sp'
                                    color: [0.75, 0.85, 0.9, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Vitesse PV (encodeur) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.speed_pv_text + ' (' + root.encoder_raw_text + ')'
                                    size_hint_x: 0.38
                                    font_size: '13sp'
                                    bold: True
                                    color: [0.4, 1, 0.4, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Glissement compensé :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.drift_pct_text
                                    size_hint_x: 0.38
                                    font_size: '12sp'
                                    color: [0.85, 0.75, 1, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Statut Modbus 1 (Consigne) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Button:
                                    text: root.modbus_act1_text
                                    font_size: '11sp'
                                    bold: True
                                    size_hint_x: 0.38
                                    background_color: root.modbus_act1_bg
                                    background_normal: ''
                                    disabled: True

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Statut Modbus 2 (Mesure) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.modbus_act2_text
                                    size_hint_x: 0.38
                                    font_size: '12sp'
                                    color: [0.8, 0.8, 0.8, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Statut Modbus 3 :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.modbus_act3_text
                                    size_hint_x: 0.38
                                    font_size: '12sp'
                                    color: [0.8, 0.8, 0.8, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Inclinaison Lift (SP / PV) :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.lift_sp_text + ' / ' + root.lift_pv_text
                                    size_hint_x: 0.38
                                    font_size: '12sp'
                                    color: [0.8, 0.85, 0.9, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                Label:
                                    text: 'Masque activation PID :'
                                    size_hint_x: 0.62
                                    font_size: '12sp'
                                    halign: 'left'
                                    valign: 'middle'
                                    text_size: self.size
                                Label:
                                    text: root.pid_enable_text
                                    size_hint_x: 0.38
                                    font_size: '12sp'
                                    color: [0.8, 0.85, 0.9, 1]
                                    halign: 'right'
                                    valign: 'middle'
                                    text_size: self.size

                        # CARTE 3: ENTREES DE SECURITE (DI)
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            padding: ['10dp', '8dp', '10dp', '8dp']
                            spacing: '6dp'
                            canvas.before:
                                Color:
                                    rgba: 0.14, 0.16, 0.19, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            Label:
                                text: 'ENTRÉES NUMÉRIQUES (DI) - SÉCURITÉS'
                                font_size: '13sp'
                                bold: True
                                color: [0.4, 0.85, 1, 1]
                                size_hint_y: None
                                height: '24dp'
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size

                            GridLayout:
                                cols: 3
                                size_hint_y: None
                                height: self.minimum_height
                                row_default_height: '32dp'
                                row_force_default: True
                                spacing: ['8dp', '6dp']

                                # Front
                                Button:
                                    text: 'AVANT : COUPÉ' if root.secu_front_val else 'AVANT : OK'
                                    font_size: '12sp'
                                    bold: True
                                    background_color: [0.85, 0.2, 0.2, 1] if root.secu_front_val else [0.2, 0.5, 0.25, 1]
                                    background_normal: ''
                                    disabled: True

                                # Back
                                Button:
                                    text: 'ARRIÈRE : COUPÉ' if root.secu_back_val else 'ARRIÈRE : OK'
                                    font_size: '12sp'
                                    bold: True
                                    background_color: [0.85, 0.2, 0.2, 1] if root.secu_back_val else [0.2, 0.5, 0.25, 1]
                                    background_normal: ''
                                    disabled: True

                                # Emergency
                                Button:
                                    text: 'URGENCE : ACTIVE' if root.secu_emergency_val else 'URGENCE : OK'
                                    font_size: '12sp'
                                    bold: True
                                    background_color: [0.9, 0.15, 0.15, 1] if root.secu_emergency_val else [0.2, 0.5, 0.25, 1]
                                    background_normal: ''
                                    disabled: True

                                # Left
                                Button:
                                    text: 'GAUCHE : ACTIVE' if root.secu_left_val else 'GAUCHE : OK'
                                    font_size: '12sp'
                                    bold: True
                                    background_color: [0.85, 0.2, 0.2, 1] if root.secu_left_val else [0.2, 0.5, 0.25, 1]
                                    background_normal: ''
                                    disabled: True

                                # Right
                                Button:
                                    text: 'DROITE : ACTIVE' if root.secu_right_val else 'DROITE : OK'
                                    font_size: '12sp'
                                    bold: True
                                    background_color: [0.85, 0.2, 0.2, 1] if root.secu_right_val else [0.2, 0.5, 0.25, 1]
                                    background_normal: ''
                                    disabled: True

                                # Combiné Front/Back
                                Button:
                                    text: 'COMBINÉ : ACTIF' if root.secu_front_back_val else 'COMBINÉ : OK'
                                    font_size: '12sp'
                                    bold: True
                                    background_color: [0.85, 0.2, 0.2, 1] if root.secu_front_back_val else [0.2, 0.5, 0.25, 1]
                                    background_normal: ''
                                    disabled: True

                # --- COLONNE DROITE (JOURNAL DES EVENEMENTS LIVE) ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.46
                    padding: ['10dp', '8dp', '10dp', '8dp']
                    spacing: '6dp'
                    canvas.before:
                        Color:
                            rgba: 0.12, 0.14, 0.17, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: '28dp'
                        Label:
                            text: 'JOURNAL DES TRANSITIONS & DIAGNOSTIC'
                            font_size: '13sp'
                            bold: True
                            color: [0.4, 0.85, 1, 1]
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                        Button:
                            text: 'Effacer'
                            font_size: '12sp'
                            size_hint_x: None
                            width: '75dp'
                            background_color: [0.35, 0.37, 0.4, 1]
                            background_normal: ''
                            on_press: root.clear_log_clicked()

                    ScrollView:
                        id: log_scroll
                        do_scroll_x: False
                        do_scroll_y: True
                        bar_width: '8dp'
                        scroll_type: ['bars', 'content']
                        BoxLayout:
                            id: log_container
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: '3dp'

        # =========================================================
        # VUE 2 : EXPLORATEUR PICTORY COMPLET
        # =========================================================
        Screen:
            name: 'explorer'
            BoxLayout:
                orientation: 'vertical'
                spacing: '8dp'

                # Barre de filtre
                BoxLayout:
                    size_hint_y: None
                    height: '38dp'
                    spacing: '8dp'

                    Label:
                        text: 'Rechercher E/S :'
                        size_hint_x: None
                        width: '120dp'
                        font_size: '13sp'

                    TextInput:
                        id: search_input
                        multiline: False
                        font_size: '13sp'
                        hint_text: 'Filtrer par nom (ex: belt, secu, modbus)...'
                        on_text: root.on_search_text_changed(self.text)

                    Label:
                        text: 'Type :'
                        size_hint_x: None
                        width: '50dp'
                        font_size: '13sp'

                    ToggleButton:
                        text: 'TOUS'
                        group: 'filter_type'
                        state: 'down' if root.explorer_filter_type == 'ALL' else 'normal'
                        size_hint_x: None
                        width: '70dp'
                        font_size: '12sp'
                        allow_no_selection: False
                        on_press: root.set_explorer_type_filter('ALL')

                    ToggleButton:
                        text: 'INP (Entrées)'
                        group: 'filter_type'
                        state: 'down' if root.explorer_filter_type == 'INP' else 'normal'
                        size_hint_x: None
                        width: '100dp'
                        font_size: '12sp'
                        allow_no_selection: False
                        on_press: root.set_explorer_type_filter('INP')

                    ToggleButton:
                        text: 'OUT (Sorties)'
                        group: 'filter_type'
                        state: 'down' if root.explorer_filter_type == 'OUT' else 'normal'
                        size_hint_x: None
                        width: '100dp'
                        font_size: '12sp'
                        allow_no_selection: False
                        on_press: root.set_explorer_type_filter('OUT')

                    ToggleButton:
                        text: 'MEM'
                        group: 'filter_type'
                        state: 'down' if root.explorer_filter_type == 'MEM' else 'normal'
                        size_hint_x: None
                        width: '70dp'
                        font_size: '12sp'
                        allow_no_selection: False
                        on_press: root.set_explorer_type_filter('MEM')

                # En-tête des colonnes
                BoxLayout:
                    size_hint_y: None
                    height: '28dp'
                    padding: ['8dp', 0]
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.22, 0.26, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    Label:
                        text: 'Module / Device'
                        size_hint_x: 0.25
                        font_size: '13sp'
                        bold: True
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'Nom du signal piCtory'
                        size_hint_x: 0.35
                        font_size: '13sp'
                        bold: True
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'Type'
                        size_hint_x: None
                        width: '60dp'
                        font_size: '13sp'
                        bold: True
                        halign: 'center'
                        text_size: self.size
                    Label:
                        text: 'Valeur temps réel'
                        size_hint_x: 0.25
                        font_size: '13sp'
                        bold: True
                        halign: 'right'
                        text_size: self.size

                # Liste déroulante des signaux
                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: '8dp'
                    scroll_type: ['bars', 'content']
                    BoxLayout:
                        id: explorer_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '2dp'
